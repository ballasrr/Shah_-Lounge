# Скопируй в backend/.env и заполни. Файл .env в git не попадает.

# Ключ iikoCloud API (apiLogin). Пока пусто — сервер отдаёт тестовые данные.
IIKO_API_LOGIN=

# ID организации и группы терминалов. Узнать: python -m app.discover
# Если пусто — берутся первые из тех, что доступны ключу.
IIKO_ORGANIZATION_ID=
IIKO_TERMINAL_GROUP_ID=

# Часовой пояс заведения: в нём iiko отдаёт время броней
TIMEZONE=Europe/Moscow

# Бронь считается «на сейчас», если начинается в ближайшие N минут
RESERVE_AHEAD_MINUTES=120

# Как часто ходить в iiko, секунд. Чаще 30 не нужно.
CACHE_SECONDS=30

# Откуда разрешены запросы при разработке (сайт на localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
